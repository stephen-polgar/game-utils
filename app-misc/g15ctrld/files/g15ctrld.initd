#!/sbin/openrc-run

description="Logitech G15 keyboard controller"

command="/usr/bin/g15ctrld"
command_background="yes"
pidfile="/run/${RC_SVCNAME}.pid"

depend() {
    need localmount
    need LCDd
    after udev
    after modules
}

start_pre() {
    checkpath -d -m 0755 /var/lib/g15ctrld
    # Does the input device already exist?
	if [ -e "/proc/modules" ] ; then
		if [ ! -e "/dev/input/uinput" ] && [ ! -e "/dev/uinput" ] ; then
			# We can load modules, but uinput device does not exist
			einfo "Loading uinput module"
			/sbin/modprobe uinput > /dev/null 2> /dev/null 	|| return 1
		fi
	fi
}
