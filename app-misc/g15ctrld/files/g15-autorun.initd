#!/sbin/openrc-run

description="Initialize Logitech G15 event handling"

depend() {
    need localmount
    use net
    after udev
    after modules
}

start_pre() {
	# Does the input device already exist?
	if [ -e "/proc/modules" ] ; then
		if [ ! -e "/dev/input/uinput" ] && [ ! -e "/dev/uinput" ] ; then
			# We can load modules, but uinput device does not exist
			einfo "Loading uinput module"
			/sbin/modprobe uinput > /dev/null 2> /dev/null 	|| return 1
		fi
	fi
}

start() {
    ebegin "Checking Logitech G15 state"
    /usr/libexec/g15ctrld/g15-event.sh ready
    eend $?
}
