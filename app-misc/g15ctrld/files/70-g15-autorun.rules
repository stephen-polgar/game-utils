# G15 connected
ACTION=="add", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ATTR{idVendor}=="046d", ATTR{idProduct}=="c227", RUN+="/usr/libexec/g15ctrld/g15-event.sh plugged"

ACTION=="remove", SUBSYSTEM=="usb", ENV{DEVTYPE}=="usb_device", ENV{PRODUCT}=="46d/c227/*", RUN+="/usr/libexec/g15ctrld/g15-event.sh unplugged"
